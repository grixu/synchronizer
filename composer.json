{
    "name": "grixu/synchronizer",
    "description": "Tools for sync data from DTO (foreign system) to local DB",
    "keywords": [
        "grixu",
        "synchronizer"
    ],
    "homepage": "https://github.com/grixu/synchronizer",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Mateusz Gostański",
            "email": "mg@grixu.dev",
            "role": "Developer"
        }
    ],
    "repositories": [
        { "type": "path", "url": "../socius-dto" },
        { "type": "path", "url": "../data-factories" },
        { "type": "path", "url": "../socius-models" }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "illuminate/broadcasting": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/events": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/queue": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "laravel/slack-notification-channel": "^2.4|^3.0|^4.0",
        "spatie/laravel-data": "^4.0"
    },
    "require-dev": {
        "brainmaestro/composer-git-hooks": "^v3.0.0-alpha.1",
        "doctrine/dbal": "^3.1",
        "fakerphp/faker": "^1.11",
        "friendsofphp/php-cs-fixer": "^3.0",
        "grixu/socius-models": "@dev",
        "nunomaduro/larastan": "^2.0",
        "nunomaduro/phpinsights": "^2.0",
        "orchestra/testbench": "^8.0",
        "phpunit/phpunit": "^9.6|^10.1",
        "spatie/laravel-ray": "^1.9",
        "spatie/x-ray": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "Grixu\\Synchronizer\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Grixu\\Synchronizer\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test-coverage": "vendor/bin/phpunit --coverage-html coverage",
        "insights": "vendor/bin/phpinsights",
        "cs": "vendor/bin/php-cs-fixer fix src",
        "stan": "vendor/bin/phpstan analyse",
        "cghooks": "vendor/bin/cghooks",
        "xray": "vendor/bin/x-ray src"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Grixu\\Synchronizer\\SynchronizerServiceProvider"
            ],
            "aliases": {
                "Synchronizer": "Grixu\\Synchronizer\\SynchronizerFacade"
            }
        },
        "hooks": {
            "config": {
                "stop-on-failure": ["pre-commit", "commit-msg"]
            },
            "pre-commit": [
                "export PATH=\"/usr/local/homebrew/bin:$PATH\"",
                "./vendor/bin/x-ray src",
                "./vendor/bin/php-cs-fixer fix"
            ],
            "commit-msg": "grep -E '^(((feat|chore|docs|refactor|fix){1}\\:{1}\\s{1}[a-z]{1})|(Merge\\s?(remote\\-tracking)?\\s?branch)).*' $1",
            "post-merge": [
                "export PATH=\"/usr/local/homebrew/bin:$PATH\"",
                "composer install"
            ]
        }
    }
}
